{
  "name": "spider-maps-scraper",
  "version": "2.3.0",
  "description": "Extrae negocios de Google Maps y enriquece los datos visitando su web: teléfono, correo, WhatsApp, Instagram, Facebook y TikTok. Exporta a Excel.",
  "main": "scraper.js",
  "scripts": {
    "start": "node src/server.js",
    "cli": "node scraper.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node test/panel.browser.js",
    "test:live": "node test/prueba_funcional.js"
  },
  "keywords": [
    "google-maps",
    "scraper",
    "leads",
    "peru",
    "excel",
    "puppeteer",
    "contact-extractor"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "C1FR4",
  "license": "MIT",
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "p-limit": "^6.2.0",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "puppeteer"
    ]
  },
  "devDependencies": {
    "jszip": "^3.10.2"
  }
}
